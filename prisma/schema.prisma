generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      AuthSession[]
  customers     Customer[]
  products      Product[]
  quotes        Quote[]
  followUps     FollowUpTask[]
  messageDrafts MessageDraft[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  whatsappNumber    String?
  country           String?
  language          String?        @default("English")
  tags              String[]       @default([])
  stage             String         @default("新线索")
  interestedProduct String?
  latestSummary     String?
  nextFollowUpAt    DateTime?
  ownerId           String
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes            Quote[]
  followUps         FollowUpTask[]
  messageDrafts     MessageDraft[]

  @@index([ownerId])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String
  category       String?
  images         String[] @default([])
  videos         String[] @default([])
  colors         String[] @default([])
  sizes          String[] @default([])
  material       String?
  moq            Int?
  suggestedPrice Decimal? @db.Decimal(12, 2)
  minPrice       Decimal? @db.Decimal(12, 2)
  leadTime       String?
  sellingPoints  String[] @default([])
  introEn        String?
  introEs        String?
  introPt        String?
  introAr        String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes         Quote[]

  @@unique([ownerId, sku])
  @@index([ownerId])
}

model Quote {
  id              String   @id @default(cuid())
  customerId      String
  productId       String
  ownerId         String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  shippingCost    Decimal? @db.Decimal(12, 2)
  moq             Int?
  leadTime        String?
  includeShipping Boolean  @default(false)
  quoteText       String
  createdBy       String?
  createdAt       DateTime @default(now())
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([ownerId])
  @@index([customerId])
}

model FollowUpTask {
  id                String    @id @default(cuid())
  customerId        String
  taskType          String
  remindAt          DateTime
  recommendedScript String
  status            String    @default("pending")
  ownerId           String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([customerId])
  @@index([remindAt])
}

model MessageDraft {
  id           String    @id @default(cuid())
  customerId   String?
  ownerId      String?
  sourceText   String
  draftText    String
  intent       String?
  languageFrom String?
  languageTo   String?
  createdAt    DateTime  @default(now())
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}
