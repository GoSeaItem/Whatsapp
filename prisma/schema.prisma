generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  assignedCustomers Customer[] @relation("AssignedCustomer")
  sessions      AuthSession[]
  customers     Customer[]
  products      Product[]
  materials     Material[]
  sampleOrders  SampleOrder[]
  customRequests CustomRequest[]
  quotes        Quote[]
  followUps     FollowUpTask[]
  messageDrafts MessageDraft[]
  knowledgeBases KnowledgeBase[]
  createdOrgKnowledgeBases KnowledgeBaseOrg[] @relation("KnowledgeBaseOrgCreator")
  createdOrgScripts ScriptOrg[] @relation("ScriptOrgCreator")
  createdOrgProducts OrganizationProduct[] @relation("OrganizationProductCreator")
  createdOrgMaterials OrganizationMaterial[] @relation("OrganizationMaterialCreator")
  auditLogs     AuditLog[] @relation("AuditLogActor")
  importJobs    ImportJob[] @relation("ImportJobCreator")
  exportJobs    ExportJob[] @relation("ExportJobCreator")
  reportJobs    ReportJob[] @relation("ReportJobCreator")
  aiActionSuggestionLogs AIActionSuggestionLog[]
  customerPredictions CustomerPrediction[] @relation("CustomerPredictionUser")
  reorderReminders ReorderReminder[] @relation("ReorderReminderOwner")
  orders        Order[] @relation("OrderOwner")
  createdOrders Order[] @relation("OrderCreator")
  assignedOrders Order[] @relation("AssignedOrder")
  orderFulfillmentAlerts OrderFulfillmentAlert[] @relation("OrderFulfillmentAlertOwner")
  createdOrderCosts OrderCost[] @relation("OrderCostCreator")
  confirmedOrderCosts OrderCost[] @relation("OrderCostConfirmer")
  createdReorderCampaigns ReorderCampaign[] @relation("ReorderCampaignCreator")
  ownedReorderOpportunities ReorderOpportunity[] @relation("ReorderOpportunityOwner")
  createdReorderOpportunities ReorderOpportunity[] @relation("ReorderOpportunityCreator")
  createdReorderPlaybooks ReorderPlaybook[] @relation("ReorderPlaybookCreator")
  ownedAfterSalesCases AfterSalesCase[] @relation("AfterSalesCaseOwner")
  assignedAfterSalesCases AfterSalesCase[] @relation("AfterSalesCaseAssignee")
  createdAfterSalesCases AfterSalesCase[] @relation("AfterSalesCaseCreator")
  createdAfterSalesEvents AfterSalesEvent[] @relation("AfterSalesEventCreator")
  createdScriptExperiments ScriptExperiment[] @relation("ScriptExperimentCreator")
  createdScriptVariants ScriptVariant[] @relation("ScriptVariantCreator")
  scriptUsages ScriptUsage[] @relation("ScriptUsageUser")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   OrganizationMember[]
  roles     Role[]
  customers Customer[]
  orgKnowledgeBases KnowledgeBaseOrg[]
  orgScripts ScriptOrg[]
  orgProducts OrganizationProduct[]
  orgMaterials OrganizationMaterial[]
  auditLogs AuditLog[]
  importJobs ImportJob[]
  exportJobs ExportJob[]
  reportJobs ReportJob[]
  aiActionSuggestionLogs AIActionSuggestionLog[]
  customerPredictions CustomerPrediction[]
  reorderReminders ReorderReminder[]
  orders Order[]
  orderFulfillmentAlerts OrderFulfillmentAlert[]
  orderCosts OrderCost[]
  reorderCampaigns ReorderCampaign[]
  reorderOpportunities ReorderOpportunity[]
  reorderPlaybooks ReorderPlaybook[]
  afterSalesCases AfterSalesCase[]
  afterSalesEvents AfterSalesEvent[]
  scriptExperiments ScriptExperiment[]
  scriptVariants ScriptVariant[]
  scriptUsages ScriptUsage[]

  @@index([ownerId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  whatsappNumber    String?
  email             String?
  socialLinks       String[]       @default([])
  country           String?
  language          String?        @default("English")
  tags              String[]       @default([])
  stage             String         @default("新线索")
  interestedProduct String?
  latestSummary     String?
  nextFollowUpAt    DateTime?
  ownerId           String
  organizationId    String?
  assignedTo        String?
  collaborators     String[]       @default([])
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser      User?          @relation("AssignedCustomer", fields: [assignedTo], references: [id], onDelete: SetNull)
  quotes            Quote[]
  followUps         FollowUpTask[]
  messageDrafts     MessageDraft[]
  sampleOrders      SampleOrder[]
  customRequests    CustomRequest[]
  assignmentLogs    CustomerAssignmentLog[]
  duplicateEvents   CustomerDuplicateEventLog[]
  aiActionSuggestionLogs AIActionSuggestionLog[]
  predictions       CustomerPrediction[]
  reorderReminders  ReorderReminder[]
  reorderOpportunities ReorderOpportunity[]
  orders            Order[]
  orderFulfillmentAlerts OrderFulfillmentAlert[]
  afterSalesCases   AfterSalesCase[]
  scriptUsages       ScriptUsage[]

  @@index([ownerId])
  @@index([assignedTo])
  @@index([organizationId])
}

model CustomerDuplicateEventLog {
  id                String   @id @default(cuid())
  organizationId    String?
  ownerId           String
  attemptedBy       String
  matchedCustomerId String
  fields            String[] @default([])
  source            String
  action            String
  createdAt         DateTime @default(now())
  matchedCustomer   Customer @relation(fields: [matchedCustomerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerId])
  @@index([attemptedBy])
  @@index([matchedCustomerId])
}

model CustomerAssignmentLog {
  id             String   @id @default(cuid())
  customerId     String
  organizationId String
  fromUserId     String?
  toUserId       String?
  operatedBy     String
  note           String?
  createdAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([organizationId])
  @@index([operatedBy])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String
  category       String?
  images         String[] @default([])
  videos         String[] @default([])
  colors         String[] @default([])
  sizes          String[] @default([])
  material       String?
  moq            Int?
  suggestedPrice Decimal? @db.Decimal(12, 2)
  minPrice       Decimal? @db.Decimal(12, 2)
  leadTime       String?
  sellingPoints  String[] @default([])
  introEn        String?
  introEs        String?
  introPt        String?
  introAr        String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes         Quote[]
  knowledgeBases KnowledgeBase[]
  materials      Material[]
  sampleOrders   SampleOrder[]
  customRequests CustomRequest[]
  reorderReminders ReorderReminder[]
  reorderOpportunities ReorderOpportunity[]
  orders         Order[]
  afterSalesCases AfterSalesCase[]
  organizationProducts OrganizationProduct[]

  @@unique([ownerId, sku])
  @@index([ownerId])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  language  String   @default("other")
  productId String?
  enabled   Boolean  @default(true)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([ownerId, category])
  @@index([ownerId, language])
  @@index([ownerId, productId])
  @@index([ownerId, enabled])
}

model KnowledgeBaseOrg {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  category       String
  content        String
  language       String       @default("other")
  enabled        Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("KnowledgeBaseOrgCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, language])
  @@index([organizationId, enabled])
}

model ScriptOrg {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  category       String
  content        String
  language       String       @default("other")
  enabled        Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ScriptOrgCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, language])
  @@index([organizationId, enabled])
}

model ScriptExperiment {
  id                  String        @id @default(cuid())
  organizationId      String?
  name                String
  scenario            String
  description         String?
  status              String        @default("draft")
  targetLanguage      String?
  targetCustomerStage String?
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator             User          @relation("ScriptExperimentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  variants            ScriptVariant[]
  usages              ScriptUsage[]

  @@index([organizationId])
  @@index([scenario])
  @@index([status])
  @@index([createdBy])
}

model ScriptVariant {
  id             String           @id @default(cuid())
  experimentId   String
  organizationId String?
  title          String
  versionLabel   String
  content        String
  language       String?
  tone           String?
  enabled        Boolean          @default(true)
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  experiment     ScriptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User             @relation("ScriptVariantCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  usages         ScriptUsage[]

  @@unique([experimentId, versionLabel])
  @@index([experimentId])
  @@index([organizationId])
  @@index([versionLabel])
  @@index([enabled])
}

model ScriptUsage {
  id             String           @id @default(cuid())
  organizationId String?
  experimentId   String
  variantId      String
  customerId     String?
  userId         String
  scenario       String
  channel        String           @default("web")
  usedText       String?
  outcome        String           @default("used_draft")
  quoteId        String?
  orderId        String?
  followUpTaskId String?
  notes          String?
  usedAt         DateTime         @default(now())
  outcomeAt      DateTime?
  experiment     ScriptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant        ScriptVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user           User             @relation("ScriptUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([experimentId])
  @@index([variantId])
  @@index([customerId])
  @@index([userId])
  @@index([scenario])
  @@index([outcome])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  riskLevel      String        @default("low")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@index([userId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([riskLevel])
  @@index([createdAt])
}

model ImportJob {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  filePath       String
  dryRun         Boolean      @default(false)
  status         String       @default("pending")
  result         Json?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ImportJobCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdBy])
  @@index([type])
  @@index([status])
}

model ExportJob {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  filePath       String
  status         String       @default("pending")
  filters        Json?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ExportJobCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdBy])
  @@index([type])
  @@index([status])
}

model ReportJob {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  filters        Json?
  status         String       @default("pending")
  result         Json?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ReportJobCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdBy])
  @@index([type])
  @@index([status])
}

model AIActionSuggestionLog {
  id             String        @id @default(cuid())
  organizationId String?
  customerId     String?
  brandId        String?
  brandUsed      String?
  brandRulesUsed Json?
  userId         String
  actionType     String
  scenario       String?
  inputSnapshot  Json?
  outputSnapshot Json?
  riskLevel      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([brandId])
  @@index([userId])
  @@index([actionType])
}

model CustomerPrediction {
  id                String        @id @default(cuid())
  organizationId    String?
  customerId        String
  userId            String
  predictionType    String
  score             Int
  level             String
  reasons           Json?
  recommendedAction String?
  suggestedScript   String?
  status            String        @default("open")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user              User          @relation("CustomerPredictionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([userId])
  @@index([predictionType])
  @@index([status])
  @@unique([customerId, userId, predictionType])
}

model ReorderReminder {
  id              String        @id @default(cuid())
  organizationId  String?
  customerId      String
  productId       String?
  reminderType    String
  remindAt        DateTime
  reason          String?
  suggestedScript String?
  status          String        @default("pending")
  ownerId         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner           User          @relation("ReorderReminderOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([productId])
  @@index([ownerId])
  @@index([status])
  @@index([remindAt])
}

model ReorderCampaign {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  campaignType   String
  targetScope    String
  status         String        @default("draft")
  filters        Json?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User          @relation("ReorderCampaignCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  opportunities  ReorderOpportunity[]

  @@index([organizationId])
  @@index([campaignType])
  @@index([status])
  @@index([createdBy])
}

model ReorderOpportunity {
  id                String        @id @default(cuid())
  organizationId    String?
  customerId        String
  productId         String?
  orderId           String?
  campaignId        String?
  opportunityType   String
  score             Int
  level             String
  reasons           Json?
  recommendedAction String?
  suggestedScript   String?
  status            String        @default("open")
  ownerId           String
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product           Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  campaign          ReorderCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner             User          @relation("ReorderOpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creator           User          @relation("ReorderOpportunityCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([productId])
  @@index([campaignId])
  @@index([opportunityType])
  @@index([status])
  @@index([ownerId])
}

model ReorderPlaybook {
  id             String        @id @default(cuid())
  organizationId String?
  title          String
  scenario       String
  language       String
  content        String
  enabled        Boolean       @default(true)
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User          @relation("ReorderPlaybookCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([scenario])
  @@index([language])
  @@index([enabled])
  @@index([createdBy])
}

model Material {
  id          String   @id @default(cuid())
  title       String
  type        String
  url         String
  description String?
  language    String   @default("other")
  productId   String?
  tags        String[] @default([])
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  organizationMaterials OrganizationMaterial[]

  @@index([ownerId])
  @@index([ownerId, type])
  @@index([ownerId, language])
  @@index([ownerId, productId])
}

model OrganizationProduct {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator        User         @relation("OrganizationProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@index([productId])
  @@index([createdBy])
}

model OrganizationMaterial {
  id             String       @id @default(cuid())
  organizationId String
  materialId     String
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  creator        User         @relation("OrganizationMaterialCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([organizationId, materialId])
  @@index([organizationId])
  @@index([materialId])
  @@index([createdBy])
}

model Quote {
  id              String   @id @default(cuid())
  customerId      String
  productId       String
  ownerId         String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  shippingCost    Decimal? @db.Decimal(12, 2)
  moq             Int?
  leadTime        String?
  includeShipping Boolean  @default(false)
  quoteText       String
  createdBy       String?
  createdAt       DateTime @default(now())
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  orders          Order[]

  @@index([ownerId])
  @@index([customerId])
}

model SampleOrder {
  id                   String   @id @default(cuid())
  customerId           String
  productId            String?
  sampleName           String
  sampleFee            Decimal? @db.Decimal(12, 2)
  shippingCost         Decimal? @db.Decimal(12, 2)
  currency             String   @default("USD")
  paymentStatus        String   @default("unpaid")
  shippingStatus       String   @default("pending")
  trackingNumber       String?
  feedbackStatus       String   @default("pending")
  expectedShipDate     DateTime?
  expectedDeliveryDate DateTime?
  notes                String?
  ownerId              String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  owner                User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders               Order[]

  @@index([ownerId])
  @@index([customerId])
  @@index([productId])
  @@index([ownerId, paymentStatus])
  @@index([ownerId, shippingStatus])
  @@index([ownerId, feedbackStatus])
}

model CustomRequest {
  id                  String   @id @default(cuid())
  customerId          String
  productId           String?
  requestType         String
  logoRequired        Boolean  @default(false)
  packagingRequired   Boolean  @default(false)
  colorRequirement    String?
  sizeRequirement     String?
  materialRequirement String?
  quantity            Int?
  moq                 Int?
  sampleFee           Decimal? @db.Decimal(12, 2)
  sampleLeadTime      String?
  bulkLeadTime        String?
  files               String[] @default([])
  status              String   @default("draft")
  notes               String?
  ownerId             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders              Order[]

  @@index([ownerId])
  @@index([customerId])
  @@index([productId])
  @@index([ownerId, requestType])
  @@index([ownerId, status])
}

model Order {
  id                   String        @id @default(cuid())
  organizationId       String?
  customerId           String
  quoteId              String?
  sampleOrderId        String?
  customRequestId      String?
  orderNo              String
  orderType            String
  title                String?
  amount               Decimal?      @db.Decimal(12, 2)
  currency             String?
  quantity             Int?
  productId            String?
  paymentStatus        String        @default("unpaid")
  productionStatus     String        @default("not_started")
  shippingStatus       String        @default("pending")
  afterSalesStatus     String        @default("none")
  orderStatus          String        @default("draft")
  expectedShipDate     DateTime?
  expectedDeliveryDate DateTime?
  trackingNumber       String?
  notes                String?
  files                String[]      @default([])
  ownerId              String
  assignedTo           String?
  createdBy            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote                Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  sampleOrder          SampleOrder?  @relation(fields: [sampleOrderId], references: [id], onDelete: SetNull)
  customRequest        CustomRequest? @relation(fields: [customRequestId], references: [id], onDelete: SetNull)
  product              Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner                User          @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee             User?         @relation("AssignedOrder", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator              User          @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  followUps            FollowUpTask[]
  fulfillmentAlerts    OrderFulfillmentAlert[]
  cost                 OrderCost?
  reorderOpportunities ReorderOpportunity[]
  afterSalesCases      AfterSalesCase[]

  @@unique([organizationId, orderNo])
  @@unique([ownerId, orderNo])
  @@index([organizationId])
  @@index([customerId])
  @@index([quoteId])
  @@index([sampleOrderId])
  @@index([customRequestId])
  @@index([productId])
  @@index([ownerId])
  @@index([assignedTo])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([productionStatus])
  @@index([shippingStatus])
}

model OrderCost {
  id                    String        @id @default(cuid())
  organizationId        String?
  orderId               String        @unique
  currency              String?
  productCost           Decimal?      @db.Decimal(12, 2)
  packagingCost         Decimal?      @db.Decimal(12, 2)
  domesticShipping      Decimal?      @db.Decimal(12, 2)
  internationalShipping Decimal?      @db.Decimal(12, 2)
  paymentFee            Decimal?      @db.Decimal(12, 2)
  platformFee           Decimal?      @db.Decimal(12, 2)
  refundAmount          Decimal?      @db.Decimal(12, 2)
  reshipCost            Decimal?      @db.Decimal(12, 2)
  otherCost             Decimal?      @db.Decimal(12, 2)
  totalCost             Decimal?      @db.Decimal(12, 2)
  grossProfit           Decimal?      @db.Decimal(12, 2)
  grossMargin           Decimal?      @db.Decimal(8, 2)
  costConfirmed         Boolean       @default(false)
  confirmedBy           String?
  confirmedAt           DateTime?
  notes                 String?
  createdBy             String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator               User          @relation("OrderCostCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  confirmer             User?         @relation("OrderCostConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderId])
  @@index([createdBy])
  @@index([costConfirmed])
}

model FollowUpTask {
  id                String    @id @default(cuid())
  customerId        String
  orderId           String?
  afterSalesCaseId  String?
  taskType          String
  remindAt          DateTime
  recommendedScript String
  status            String    @default("pending")
  ownerId           String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  afterSalesCase    AfterSalesCase? @relation(fields: [afterSalesCaseId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([customerId])
  @@index([orderId])
  @@index([afterSalesCaseId])
  @@index([remindAt])
}

model OrderFulfillmentAlert {
  id                String        @id @default(cuid())
  organizationId    String?
  orderId           String
  customerId        String
  alertType         String
  level             String
  reason            String?
  recommendedAction String?
  status            String        @default("open")
  ownerId           String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner             User          @relation("OrderFulfillmentAlertOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderId])
  @@index([customerId])
  @@index([alertType])
  @@index([status])
  @@index([ownerId])
  @@unique([orderId, alertType])
}

model MessageDraft {
  id           String    @id @default(cuid())
  customerId   String?
  ownerId      String?
  sourceText   String
  draftText    String
  intent       String?
  languageFrom String?
  languageTo   String?
  createdAt    DateTime  @default(now())
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model AfterSalesCase {
  id                 String        @id @default(cuid())
  organizationId     String?
  customerId         String
  orderId            String?
  productId          String?
  caseNo             String
  caseType           String
  priority           String        @default("medium")
  status             String        @default("open")
  responsibility     String?       @default("unknown")
  requestedSolution  String?
  finalSolution      String?
  refundAmount       Decimal?      @db.Decimal(12, 2)
  reshipCost         Decimal?      @db.Decimal(12, 2)
  compensationAmount Decimal?      @db.Decimal(12, 2)
  currency           String?
  description        String?
  customerClaim      String?
  internalNotes      String?
  evidenceUrls       String[]      @default([])
  resolutionNotes    String?
  openedAt           DateTime      @default(now())
  resolvedAt         DateTime?
  closedAt           DateTime?
  ownerId            String
  assignedTo         String?
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order              Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  owner              User          @relation("AfterSalesCaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee           User?         @relation("AfterSalesCaseAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator            User          @relation("AfterSalesCaseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  events             AfterSalesEvent[]
  followUps          FollowUpTask[]

  @@unique([organizationId, caseNo])
  @@unique([ownerId, caseNo])
  @@index([organizationId])
  @@index([customerId])
  @@index([orderId])
  @@index([productId])
  @@index([caseType])
  @@index([priority])
  @@index([status])
  @@index([ownerId])
  @@index([assignedTo])
}

model AfterSalesEvent {
  id               String         @id @default(cuid())
  organizationId   String?
  afterSalesCaseId String
  eventType        String
  oldValue         Json?
  newValue         Json?
  notes            String?
  createdBy        String
  createdAt        DateTime       @default(now())
