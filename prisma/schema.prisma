generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  assignedCustomers Customer[] @relation("AssignedCustomer")
  sessions      AuthSession[]
  customers     Customer[]
  products      Product[]
  materials     Material[]
  sampleOrders  SampleOrder[]
  customRequests CustomRequest[]
  quotes        Quote[]
  followUps     FollowUpTask[]
  messageDrafts MessageDraft[]
  knowledgeBases KnowledgeBase[]
  createdOrgKnowledgeBases KnowledgeBaseOrg[] @relation("KnowledgeBaseOrgCreator")
  createdOrgScripts ScriptOrg[] @relation("ScriptOrgCreator")
  createdOrgProducts OrganizationProduct[] @relation("OrganizationProductCreator")
  createdOrgMaterials OrganizationMaterial[] @relation("OrganizationMaterialCreator")
  auditLogs     AuditLog[] @relation("AuditLogActor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   OrganizationMember[]
  roles     Role[]
  customers Customer[]
  orgKnowledgeBases KnowledgeBaseOrg[]
  orgScripts ScriptOrg[]
  orgProducts OrganizationProduct[]
  orgMaterials OrganizationMaterial[]
  auditLogs AuditLog[]

  @@index([ownerId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  whatsappNumber    String?
  email             String?
  socialLinks       String[]       @default([])
  country           String?
  language          String?        @default("English")
  tags              String[]       @default([])
  stage             String         @default("新线索")
  interestedProduct String?
  latestSummary     String?
  nextFollowUpAt    DateTime?
  ownerId           String
  organizationId    String?
  assignedTo        String?
  collaborators     String[]       @default([])
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser      User?          @relation("AssignedCustomer", fields: [assignedTo], references: [id], onDelete: SetNull)
  quotes            Quote[]
  followUps         FollowUpTask[]
  messageDrafts     MessageDraft[]
  sampleOrders      SampleOrder[]
  customRequests    CustomRequest[]
  assignmentLogs    CustomerAssignmentLog[]
  duplicateEvents   CustomerDuplicateEventLog[]

  @@index([ownerId])
  @@index([assignedTo])
  @@index([organizationId])
}

model CustomerDuplicateEventLog {
  id                String   @id @default(cuid())
  organizationId    String?
  ownerId           String
  attemptedBy       String
  matchedCustomerId String
  fields            String[] @default([])
  source            String
  action            String
  createdAt         DateTime @default(now())
  matchedCustomer   Customer @relation(fields: [matchedCustomerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerId])
  @@index([attemptedBy])
  @@index([matchedCustomerId])
}

model CustomerAssignmentLog {
  id             String   @id @default(cuid())
  customerId     String
  organizationId String
  fromUserId     String?
  toUserId       String?
  operatedBy     String
  note           String?
  createdAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([organizationId])
  @@index([operatedBy])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String
  category       String?
  images         String[] @default([])
  videos         String[] @default([])
  colors         String[] @default([])
  sizes          String[] @default([])
  material       String?
  moq            Int?
  suggestedPrice Decimal? @db.Decimal(12, 2)
  minPrice       Decimal? @db.Decimal(12, 2)
  leadTime       String?
  sellingPoints  String[] @default([])
  introEn        String?
  introEs        String?
  introPt        String?
  introAr        String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quotes         Quote[]
  knowledgeBases KnowledgeBase[]
  materials      Material[]
  sampleOrders   SampleOrder[]
  customRequests CustomRequest[]
  organizationProducts OrganizationProduct[]

  @@unique([ownerId, sku])
  @@index([ownerId])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  language  String   @default("other")
  productId String?
  enabled   Boolean  @default(true)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([ownerId, category])
  @@index([ownerId, language])
  @@index([ownerId, productId])
  @@index([ownerId, enabled])
}

model KnowledgeBaseOrg {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  category       String
  content        String
  language       String       @default("other")
  enabled        Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("KnowledgeBaseOrgCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, language])
  @@index([organizationId, enabled])
}

model ScriptOrg {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  category       String
  content        String
  language       String       @default("other")
  enabled        Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ScriptOrgCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, language])
  @@index([organizationId, enabled])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User          @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@index([userId])
  @@index([entityType])
  @@index([entityType, entityId])
}

model Material {
  id          String   @id @default(cuid())
  title       String
  type        String
  url         String
  description String?
  language    String   @default("other")
  productId   String?
  tags        String[] @default([])
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  organizationMaterials OrganizationMaterial[]

  @@index([ownerId])
  @@index([ownerId, type])
  @@index([ownerId, language])
  @@index([ownerId, productId])
}

model OrganizationProduct {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator        User         @relation("OrganizationProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@index([productId])
  @@index([createdBy])
}

model OrganizationMaterial {
  id             String       @id @default(cuid())
  organizationId String
  materialId     String
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  creator        User         @relation("OrganizationMaterialCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([organizationId, materialId])
  @@index([organizationId])
  @@index([materialId])
  @@index([createdBy])
}

model Quote {
  id              String   @id @default(cuid())
  customerId      String
  productId       String
  ownerId         String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  shippingCost    Decimal? @db.Decimal(12, 2)
  moq             Int?
  leadTime        String?
  includeShipping Boolean  @default(false)
  quoteText       String
  createdBy       String?
  createdAt       DateTime @default(now())
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([ownerId])
  @@index([customerId])
}

model SampleOrder {
  id                   String   @id @default(cuid())
  customerId           String
  productId            String?
  sampleName           String
  sampleFee            Decimal? @db.Decimal(12, 2)
  shippingCost         Decimal? @db.Decimal(12, 2)
  currency             String   @default("USD")
  paymentStatus        String   @default("unpaid")
  shippingStatus       String   @default("pending")
  trackingNumber       String?
  feedbackStatus       String   @default("pending")
  expectedShipDate     DateTime?
  expectedDeliveryDate DateTime?
  notes                String?
  ownerId              String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  owner                User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([customerId])
  @@index([productId])
  @@index([ownerId, paymentStatus])
  @@index([ownerId, shippingStatus])
  @@index([ownerId, feedbackStatus])
}

model CustomRequest {
  id                  String   @id @default(cuid())
  customerId          String
  productId           String?
  requestType         String
  logoRequired        Boolean  @default(false)
  packagingRequired   Boolean  @default(false)
  colorRequirement    String?
  sizeRequirement     String?
  materialRequirement String?
  quantity            Int?
  moq                 Int?
  sampleFee           Decimal? @db.Decimal(12, 2)
  sampleLeadTime      String?
  bulkLeadTime        String?
  files               String[] @default([])
  status              String   @default("draft")
  notes               String?
  ownerId             String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([customerId])
  @@index([productId])
  @@index([ownerId, requestType])
  @@index([ownerId, status])
}

model FollowUpTask {
  id                String    @id @default(cuid())
  customerId        String
  taskType          String
  remindAt          DateTime
  recommendedScript String
  status            String    @default("pending")
  ownerId           String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([customerId])
  @@index([remindAt])
}

model MessageDraft {
  id           String    @id @default(cuid())
  customerId   String?
  ownerId      String?
  sourceText   String
  draftText    String
  intent       String?
  languageFrom String?
  languageTo   String?
  createdAt    DateTime  @default(now())
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}
