# Production/staging environment template.
# Copy to .env.production on the server and fill values manually.
# Never commit .env.production or real secrets.

NODE_ENV=production
PORT=4000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=whatsapp_ai_sales
DATABASE_URL=

SESSION_SECRET=
COOKIE_SECRET=

WEB_ORIGIN=http://187.77.138.174
API_ORIGIN=http://187.77.138.174
CORS_ORIGINS=http://187.77.138.174
CHROME_EXTENSION_ORIGIN=

# Optional: a single OpenAI key, kept for backward compatibility.
OPENAI_API_KEY=
# Recommended: multiple keys separated by comma, semicolon, or new line.
# The API will try the next key if one key is rate-limited, quota-exhausted, or temporarily unavailable.
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INSTANT_MODEL=gpt-4o-mini
OPENAI_THINKING_MODEL=gpt-4.1
OPENAI_GPT55_INSTANT_MODEL=gpt-5.5-instant
OPENAI_GPT55_THINKING_MODEL=gpt-5.5-thinking
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
# DeepSeek V4-compatible key pool. Multiple keys can be separated by comma, semicolon, or new line.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_FASTEST_MODEL=deepseek-v4-flash
DEEPSEEK_V4_THINKING_MODEL=deepseek-v4-pro
DEEPSEEK_V4_CHAT_MODEL=deepseek-v4-chat
DEEPSEEK_V4_REASONER_MODEL=deepseek-v4-reasoner
# Optional but recommended when storing OpenAI keys in the backend key pool.
# If omitted, COOKIE_SECRET or SESSION_SECRET is used for encryption.
OPENAI_KEY_ENCRYPTION_SECRET=

# IP staging over HTTP
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Seed-only admin account. Set manually before running npm run db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
