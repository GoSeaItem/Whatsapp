{
  "manifest_version": 3,
  "name": "WhatsApp AI Sales Assistant",
  "description": "A WhatsApp Web quick toolbar and AI workbench for draft replies, translation, quotes, materials, and sales workflows. It never sends messages automatically.",
  "version": "1.0.0",
  "action": {
    "default_title": "WhatsApp AI Sales Assistant",
    "default_popup": "popup.html"
  },
  "permissions": ["clipboardWrite", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://187.77.138.174/*",
    "https://api.yourdomain.com/*",
    "https://app.yourdomain.com/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
